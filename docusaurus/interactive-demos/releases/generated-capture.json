        "x": 0.12,
        "y": 20.88,
        "w": 4.06,
        "h": 6.5
      }
    },
    {
      "type": "explain",
      "image": "/img/assets/interactive-demos/releases/01",
      "text": "All created releases will be displayed in this area, first in the **Pending tab** then in the **Done tab** once they happened.",
