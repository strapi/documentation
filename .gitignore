# Keep Claude Code local files ignored, but track the shared project settings
# (.claude/settings.json) and the committed links to the Inki skills and agents.
**/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/inki-*
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/inki-*

# Local artifacts from Anthropic superpowers skill plugin (brainstorm, plans, specs).
# These are working notes from individual contributors and should never be tracked.
.superpowers/
docs/superpowers/

# Inki plugin run logs, in case a user points --log-dir at a local .inki/ folder.
# By default logs go to ~/.inki/logs/ (outside any repo); this is a safety net.
.inki/

# Playwright MCP local artifacts (snapshots, screenshots, console logs) created
# during local visual QA. Never tracked.
.playwright-mcp/
